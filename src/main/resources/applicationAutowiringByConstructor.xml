<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="specification" class="com.autowire.constructor.Specification">
        <property name="make" value="BMW"/>
        <property name="model" value="M5"/>
    </bean>
    <bean id="myCar" class="com.autowire.constructor.Car" autowire="constructor"/>
    <!-- here it is not constructor injection, it is injection with type, whatever the name, it wont care -->

</beans>